{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨国展览成果释出协调领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "RECORD_REGISTERED",
        "OBJECT_REGISTERED",
        "LOAN_TERMS_REGISTERED",
        "EMBARGO_REGISTERED",
        "EMBARGO_EXTENDED",
        "CLAIM_PROPOSED",
        "CLAIM_CORRECTED",
        "TRANSLATION_DRAFTED",
        "TASK_OPENED",
        "TASK_CLOSED",
        "DISPUTE_FILED",
        "DISPUTE_RESOLVED",
        "RELEASE_REQUESTED",
        "BILATERAL_APPROVAL_RECORDED",
        "REQUEST_APPROVED",
        "REQUEST_REJECTED",
        "PUBLIC_VARIANT_ISSUED",
        "PUBLICATION_SUSPENDED",
        "PUBLICATION_REINSTATED",
        "PUBLICATION_CORRECTION_LINKED",
        "OBJECT_WITHDRAWN",
        "OBJECT_RETURNED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "excavation_record",
        "find_object",
        "research_claim",
        "translation",
        "loan_terms",
        "embargo",
        "release_request",
        "public_variant",
        "dispute",
        "task"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
