{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨国展览成果释出协调领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "UNIT_REGISTERED",
        "ARTIFACT_REGISTERED",
        "RECORD_REGISTERED",
        "RECORD_AMENDED",
        "CONTRIBUTOR_REGISTERED",
        "LOAN_TERMS_RECORDED",
        "EMBARGO_SET",
        "EMBARGO_EXTENDED",
        "CLAIM_PROPOSED",
        "CLAIM_CORRECTED",
        "TRANSLATION_SUBMITTED",
        "TRANSLATION_REVISED",
        "CARRIER_REGISTERED",
        "RELEASE_REQUESTED",
        "BILATERAL_APPROVAL_RECORDED",
        "RELEASE_APPROVED",
        "PUBLIC_VARIANT_ISSUED",
        "VARIANT_CORRECTED",
        "VARIANT_SUSPENDED",
        "VARIANT_RESUMED",
        "ARTIFACT_WITHDRAWN",
        "ARTIFACT_REINSTATED",
        "TASK_OPENED",
        "TASK_RESOLVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "excavation_unit",
        "artifact",
        "excavation_record",
        "contributor",
        "loan_terms",
        "embargo",
        "research_claim",
        "translation",
        "public_carrier",
        "release_request",
        "public_variant",
        "coordination_task"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
