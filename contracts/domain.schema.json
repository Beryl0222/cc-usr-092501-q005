{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨国展览成果释出协调领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "RECORD_REGISTERED",
        "CLAIM_PROPOSED",
        "RELEASE_REQUESTED",
        "BILATERAL_APPROVAL_RECORDED",
        "PUBLIC_VARIANT_ISSUED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "excavation_record",
        "research_claim",
        "release_request",
        "public_variant"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
